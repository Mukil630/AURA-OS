# MUKIL MASTER AGENT - Configuration Template
# Environment: local | staging | production
ENVIRONMENT=local
APP_NAME="MUKIL MASTER AGENT"
API_VERSION=v1
LOG_LEVEL=INFO

# Server Config
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite for local testing)
DATABASE_URL=sqlite+aiosqlite:///./data/master_agent.db

# Redis / Message Broker (for queues & realtime pub/sub)
REDIS_URL=redis://localhost:6379/0

# Model / LLM Configuration (Provider Agnostic - loaded via secrets)
DEFAULT_LLM_PROVIDER=gemini
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Cloud File Vault / Google Drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=1nGZG5-eIcxmkgQxBtZ7tjGTUoWWNY4m1

# Local PC Worker Connection (Outbound Token)
PC_WORKER_AUTH_TOKEN=generate_pc_worker_token_here
